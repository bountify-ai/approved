# Approved judge worker: environment NAMES only. Copy to .env (gitignored) and fill in.
# Credentials: prefer the *_FILE form (a path to a file holding the value).

# Tenant facade (approval serve behind the image supervisor). TENANT credential only.
FACADE_URL=https://api.maritime.sh/a/<agent-id>
TENANT_TOKEN_FILE=/run/secrets/approval_tenant_token
# TENANT_TOKEN=

# Advisory channel (optional; unset means verdicts are logged but not sent).
# The judge's OWN bot (a second bot; never the approval bot). The approver must /start it.
JUDGE_TG_BOT_TOKEN_FILE=/run/secrets/judge_bot_token
# JUDGE_TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_API_BASE=https://api.telegram.org   (the demo points this at its fake Bot API)

# Weights & Biases: Weave traces and W&B Inference.
WANDB_ENTITY=bountify
WANDB_PROJECT=judgy
WANDB_API_KEY_FILE=/run/secrets/wandb_api_key
# INFERENCE_API_KEY_FILE=   (defaults to the W&B key)
INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
REVIEWER_MODEL=

# Operator console (python -m approved serve). Required outside demo mode.
CONSOLE_TOKEN_FILE=/run/secrets/console_token
# CONSOLE_PORT=8000   (a platform-injected PORT wins)
# PUBLIC_BASE_PATH=/a/<agent-id>   (the console's prefix on a shared origin; cookies use it)
# CONSOLE_ENABLED=1   (0: judge only, /health still served; use 0 on a shared origin in production)
# TRUSTED_PROXY_HOPS=0   (1 behind Maritime's public proxy: rate limits key on its X-Forwarded-For)
# ALLOW_INSECURE_FACADE=0   (1 permits an http:// single-label facade host, e.g. a compose service)
# APPROVED_DEMO=1     (demo only: allows running without a console token)

# Behaviour
STATE_DIR=state
# POLICY_FILE=path/to/APPROVAL.md   (class rule excerpt for the reviewer, if readable)
JUDGE_TIMEOUT_S=25
JUDGE_MAX_AGE_S=900
POLL_INTERVAL_S=5
FOLLOW_LIMIT=200
HTTP_TIMEOUT_S=20
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=60
FEEDBACK_TIMEOUT_S=15
# OFFLINE=1   deterministic rule-based reviewer, no network (demo and CI)
